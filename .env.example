# AtlasOps runtime configuration — PLACEHOLDERS ONLY.
#
# Copy to `.env` and fill in for your own environment. Never commit `.env`.
# No real endpoint, credential, or token belongs in this file or in any tracked
# file. See SECURITY.md for how secrets are supplied at runtime.
#
# Historical note: an earlier revision of CLAUDE.md published live service IPs
# and a Grafana admin credential. Those values remain in this repository's public
# Git history and must be rotated at the source — removing them from the working
# tree does not revoke them.

# ---------------------------------------------------------------------------
# Observability endpoints
# ---------------------------------------------------------------------------
# Supplied at runtime; never committed. Leave unset to use the local Kind
# cluster defaults from infra/local/setup_local.sh.
GRAFANA_URL=
PROMETHEUS_URL=
ALERTMANAGER_URL=
JAEGER_URL=

# ---------------------------------------------------------------------------
# Argo CD
# ---------------------------------------------------------------------------
ARGOCD_URL=
ARGOCD_USER=
ARGOCD_PASS=
# Set to "false" only against a cluster with a self-signed certificate.
ARGOCD_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# AtlasOps service credentials
# ---------------------------------------------------------------------------
ATLASOPS_API_KEY=
ATLASOPS_AUDIT_SECRET=
ALERTMANAGER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# LLM backend
# ---------------------------------------------------------------------------
# BACKEND: vllm | fireworks | openai
BACKEND=vllm
LLM_API_KEY=
AGENT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Judge model (scores agent trajectories).
JUDGE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct
# Set to "1" to score against a live judge instead of the offline fallback.
ATLASOPS_LIVE_JUDGE=0

# ---------------------------------------------------------------------------
# Hugging Face (Spaces deployment + optional hosted inference)
# ---------------------------------------------------------------------------
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
HF_INFERENCE_BASE=
ATLASOPS_USE_HF_INFERENCE=0
ATLASOPS_AUTO_HF_INFERENCE=0

# ---------------------------------------------------------------------------
# Comms integrations (both optional; runs always log locally regardless)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_USERNAME=AtlasOps

# ---------------------------------------------------------------------------
# Cluster / cloud targets
# ---------------------------------------------------------------------------
GCP_PROJECT=
KUBECONFIG_CONTEXT=

# ---------------------------------------------------------------------------
# Local paths and run behaviour
# ---------------------------------------------------------------------------
ATLASOPS_RUNTIME_DATA_DIR=data
ATLASOPS_AUDIT_LOG=data/audit.jsonl
TRAJECTORIES_DIR=data/trajectories
POSTMORTEM_DIR=data/postmortems
APPROVAL_TIMEOUT_SECONDS=300
