apiVersion: v1
kind: ServiceAccount
metadata:
  name: atlasops-coordinator
  namespace: default
automountServiceAccountToken: true
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: atlasops-coordinator-readonly
rules:
  - apiGroups: [""]
    resources: ["pods", "pods/log", "services", "endpoints", "events", "nodes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["apps"]
    resources: ["deployments", "replicasets", "statefulsets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["metrics.k8s.io"]
    resources: ["pods", "nodes"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: atlasops-coordinator-readonly
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: atlasops-coordinator-readonly
subjects:
  - kind: ServiceAccount
    name: atlasops-coordinator
    namespace: default
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: atlasops-coordinator-remediation
  namespace: default
rules:
  - apiGroups: ["apps"]
    resources: ["deployments", "deployments/scale"]
    verbs: ["get", "list", "watch", "patch", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: atlasops-coordinator-remediation
  namespace: default
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: atlasops-coordinator-remediation
subjects:
  - kind: ServiceAccount
    name: atlasops-coordinator
    namespace: default
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: atlasops-coordinator-config
  namespace: default
data:
  BACKEND: "__ATLASOPS_BACKEND__"
  VLLM_BASE: "__ATLASOPS_VLLM_BASE__"
  AGENT_MODEL: "__ATLASOPS_AGENT_MODEL__"
  GCP_PROJECT: "__ATLASOPS_GCP_PROJECT__"
  PROMETHEUS_URL: "http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090"
  ALERTMANAGER_URL: "http://prometheus-kube-prometheus-alertmanager.monitoring.svc.cluster.local:9093"
  ARGOCD_VERIFY_TLS: "true"
  ATLASOPS_AUDIT_LOG: "/var/lib/atlasops/audit/audit_log.jsonl"
  ATLASOPS_RUNTIME_DATA_DIR: "/var/lib/atlasops/comms"
  POSTMORTEM_DIR: "/var/lib/atlasops/postmortems"
  TRAJECTORIES_DIR: "/var/lib/atlasops/trajectories"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: atlasops-coordinator
  namespace: default
  labels:
    app.kubernetes.io/name: atlasops-coordinator
    app.kubernetes.io/part-of: atlasops
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: atlasops-coordinator
  template:
    metadata:
      labels:
        app.kubernetes.io/name: atlasops-coordinator
        app.kubernetes.io/part-of: atlasops
    spec:
      serviceAccountName: atlasops-coordinator
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: coordinator
          image: "__ATLASOPS_COORDINATOR_IMAGE__"
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 9099
              protocol: TCP
          envFrom:
            - configMapRef:
                name: atlasops-coordinator-config
          env:
            - name: ATLASOPS_AUDIT_SECRET
              valueFrom:
                secretKeyRef:
                  name: atlasops-coordinator-secrets
                  key: atlasops-audit-secret
            - name: ALERTMANAGER_WEBHOOK_SECRET
              valueFrom:
                secretKeyRef:
                  name: atlasops-coordinator-secrets
                  key: alertmanager-webhook-secret
            - name: ATLASOPS_API_KEY
              valueFrom:
                secretKeyRef:
                  name: atlasops-coordinator-secrets
                  key: atlasops-api-key
            - name: LLM_API_KEY
              valueFrom:
                secretKeyRef:
                  name: atlasops-coordinator-secrets
                  key: llm-api-key
                  optional: true
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 3
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20
            timeoutSeconds: 2
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            privileged: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: runtime-data
              mountPath: /var/lib/atlasops
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: runtime-data
          emptyDir: {}
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: atlasops-coordinator-svc
  namespace: default
  labels:
    app.kubernetes.io/name: atlasops-coordinator
    app.kubernetes.io/part-of: atlasops
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: atlasops-coordinator
  ports:
    - name: http
      port: 9099
      targetPort: http
      protocol: TCP
